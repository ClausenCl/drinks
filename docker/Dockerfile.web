FROM node:22-alpine AS deps
WORKDIR /repo/app/frontend
COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /repo/app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
# Keep build memory usage low for small servers (can be overridden at build time).
ENV NEXT_BUILD_WORKER_COUNT=1
ENV NODE_OPTIONS=--max-old-space-size=384
COPY --from=deps /repo/app/frontend/node_modules ./node_modules
COPY app/frontend ./
COPY backend /repo/backend
COPY prisma /repo/prisma
# Prisma infers a "project root" from the schema path. When the schema lives outside this
# package, Prisma may try to auto-install packages at /repo (which has no package.json),
# causing builds to fail (or get OOM-killed). Link the schema into this package and run
# the locally-installed Prisma CLI.
RUN ln -s /repo/prisma ./prisma
RUN node scripts/with-env.mjs prisma generate --schema prisma/schema.prisma
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /repo/app/frontend
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /repo/app/frontend/package.json ./package.json
COPY --from=build /repo/app/frontend/node_modules ./node_modules
COPY --from=build /repo/app/frontend/.next ./.next
COPY --from=build /repo/app/frontend/public ./public
COPY --from=build /repo/app/frontend/scripts ./scripts
COPY --from=build /repo/backend /repo/backend
COPY --from=build /repo/prisma /repo/prisma
RUN [ -e prisma ] || ln -s /repo/prisma prisma
EXPOSE 3000
CMD ["node", "scripts/prod-start.mjs"]
